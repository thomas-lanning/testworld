# Local development env for Supabase CLI (functions run in Docker)
# Ensures the Edge Function can access your Mac's Ollama instance
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
# Uncomment if using Ollama Cloud or any OpenAI-compatible provider
# OLLAMA_API_URL=https://api.ollama.ai
# OLLAMA_API_KEY=your_api_key_here
